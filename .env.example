# ==============================================================================
# ATHLETE ID CARD GENERATION SYSTEM - KYORIX SPORTS TECHNOLOGY
# Environment Configuration Specification (Phase 1 Foundation)
# NOTE: This system is isolated and does NOT share database or auth with Kyorix Manager
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Direct or pooled PostgreSQL connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/kyorix_athlete_id_db?schema=public"

# Direct URL for Prisma CLI migrations when using transaction poolers (Supabase/PgBouncer)
DIRECT_URL="postgresql://postgres:your_password@localhost:5432/kyorix_athlete_id_db?schema=public"

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Cryptographically strong secret for signing JWT admin session tokens (min 32 chars)
JWT_SECRET="kyorix-athlete-id-sys-secure-jwt-secret-min32chars-2026!"

# Admin session expiration duration (e.g., 8h, 24h, 7d)
JWT_EXPIRES_IN="12h"

# Athlete card access token secret (used to sign athlete self-service download tokens)
ATHLETE_ACCESS_SECRET="kyorix-athlete-token-secret-selfservice-32chars!"

# Token expiration for athlete one-time or time-limited download links (e.g., 30m, 1h)
ATHLETE_DOWNLOAD_TOKEN_EXPIRES_IN="1h"

# ------------------------------------------------------------------------------
# 3. PRIVATE IMAGE & ASSET STORAGE ARCHITECTURE
# ------------------------------------------------------------------------------
# Storage Provider: "local" (Private file system outside public directory) or "s3" or "supabase"
STORAGE_PROVIDER="local"

# Directory path where private athlete photographs and generated ID cards are stored
# IMPORTANT: This directory MUST NEVER be inside /public to prevent unauthorized access
STORAGE_LOCAL_ROOT="./storage/private"

# Maximum photograph upload size in bytes (5 MB = 5242880 bytes)
MAX_PHOTO_SIZE_BYTES=5242880

# Allowed MIME types (comma-separated)
ALLOWED_PHOTO_MIME_TYPES="image/jpeg,image/png,image/webp"

# Optional Cloud Storage configuration (used if STORAGE_PROVIDER="supabase" or "s3")
STORAGE_BUCKET_PHOTOS="athlete-photos-private"
STORAGE_BUCKET_ID_CARDS="athlete-id-cards-private"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# 4. APPLICATION CONTEXT & BASE URL
# ------------------------------------------------------------------------------
APP_ENV="development"
APP_URL="http://localhost:3000"
LOG_LEVEL="info"

# ------------------------------------------------------------------------------
# 5. INITIAL SYSTEM BOOTSTRAP (For first-time admin setup)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL="admin@kyorix.sports"
INITIAL_ADMIN_PASSWORD="kyorix@2026"
INITIAL_ADMIN_NAME="System Administrator"

